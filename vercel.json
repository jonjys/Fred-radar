{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "trailingSlash": false,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/health", "destination": "/health.json" },
    { "source": "/sv", "destination": "/sv.html" },
    { "source": "/sv/", "destination": "/sv.html" },
    { "source": "/best", "destination": "/basta.html" },
    { "source": "/alternatives", "destination": "/alternativ.html" },
    { "source": "/sv/best", "destination": "/basta.html" },
    { "source": "/sv/alternatives", "destination": "/alternativ.html" },
    { "source": "/sv/quiz", "destination": "/quiz.html" },
    { "source": "/sv/basta", "destination": "/basta.html" },
    { "source": "/sv/alternativ", "destination": "/alternativ.html" },
    { "source": "/sv/om", "destination": "/om.html" },
    { "source": "/sv/kategori/:path*", "destination": "/kategori/:path*" },
    { "source": "/sv/alternativ/:path*", "destination": "/alternativ/:path*" },
    { "source": "/sv/go", "destination": "/go/index.html" },
    { "source": "/sv/go/:path*", "destination": "/go/:path*" },
    { "source": "/sv/:path*", "destination": "/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://fred-platform.vercel.app https://*.vercel.app"
        },
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/health.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }]
    },
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }]
    },
    {
      "source": "/locales/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }]
    }
  ]
}
